# Server-only. Never prefix with VITE_ or NEXT_PUBLIC_ for secrets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_SITE_URL=https://still.app
# Set true only when the configured external AI route is restricted to ZDR providers.
# AI_ZERO_DATA_RETENTION=false
# Optional fallback if OpenRouter is unset:
# XAI_API_KEY=
# Password recovery email (Resend):
# RESEND_API_KEY=
# EMAIL_FROM=Still <hello@your-domain.com>
# APP_URL=https://your-still-domain.com

# Optional Upstash services. The app keeps working without them.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_VECTOR_REST_URL=
# UPSTASH_VECTOR_REST_TOKEN=
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# Auth / database (injected on deploy; optional locally — preview uses PGLite)
# AUTH_SECRET=
# DATABASE_URL=
